{
  "name": "knowledge-hub",
  "version": "0.2.0",
  "private": true,
  "description": "Personal knowledge vault — a local-first desktop app for organising everything you learn.",
  "author": "Dung Ta",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "next dev renderer -p 3100",
    "dev:electron": "wait-on tcp:127.0.0.1:3100 && npm run build:main && cross-env NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "cross-env NODE_ENV=production next build renderer",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "smoke": "npm run smoke:build && cross-env ELECTRON_RUN_AS_NODE=1 electron dist/smoke.js",
    "smoke:build": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=node20 --external:better-sqlite3 --external:mammoth --external:electron --external:electron-updater --outfile=dist/smoke.js",
    "tidy:filenames": "npm run tidy:build && cross-env ELECTRON_RUN_AS_NODE=1 electron dist/tidy-filenames.js",
    "tidy:build": "esbuild scripts/tidy-filenames.ts --bundle --platform=node --format=cjs --target=node20 --external:better-sqlite3 --external:mammoth --external:electron --external:electron-updater --outfile=dist/tidy-filenames.js",
    "shots": "npm run build && esbuild scripts/screenshot.ts --bundle --platform=node --format=cjs --target=node20 --external:better-sqlite3 --external:mammoth --external:electron --external:electron-updater --outfile=dist/screenshot.js && electron dist/screenshot.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p renderer/tsconfig.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dompurify": "^3.2.5",
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.3",
    "lucide-react": "^0.503.0",
    "marked": "^15.0.11",
    "next": "^15.3.1",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  }
}
